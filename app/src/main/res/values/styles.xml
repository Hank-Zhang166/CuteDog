<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CuteDog" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF7F0</item>
        <item name="android:navigationBarColor">#FAF7F0</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#4D6B57</item>
    </style>
    <style name="Theme.CuteDog.PetChat" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:colorAccent">#4D6B57</item>
    </style>
</resources>
