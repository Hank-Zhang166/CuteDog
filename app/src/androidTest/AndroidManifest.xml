<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AGP applies testInstrumentationRunner to the first instrumentation declaration. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.cutedog.app" />
    <!-- Host-only probe: this second runner exists exclusively in the instrumentation APK. -->
    <instrumentation
        android:name="com.cutedog.app.reminder.SystemRecoveryProbeRunner"
        android:targetPackage="com.cutedog.app"
        android:functionalTest="true"
        android:label="CuteDog system recovery host probe" />
</manifest>
